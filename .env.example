# Leave INSTAGRAM_ACCESS_TOKEN empty to run Glim in demo mode with a fictional sample account.

# Long-lived token from your Meta app.
#   Instagram login tokens start with "IG"  -> graph.instagram.com
#   Facebook login tokens start with "EAA"  -> graph.facebook.com (needed for hashtag search)
INSTAGRAM_ACCESS_TOKEN=

# Your Instagram professional account ID. Required for Facebook login tokens; optional for Instagram login.
INSTAGRAM_USER_ID=

# Graph API version (optional)
INSTAGRAM_API_VERSION=v26.0
