{
  "name": "glim-mcp",
  "version": "0.1.0",
  "description": "MCP server for Instagram professional accounts: profile, insights, publishing, comments, DMs and hashtags through the official Graph API.",
  "type": "module",
  "bin": { "glim-mcp": "dist/index.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": ["mcp", "model-context-protocol", "instagram", "instagram-graph-api", "claude", "social-media", "ai-agent"],
  "author": "Jagdish Patil",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/jagdish3135/glim.git" },
  "homepage": "https://github.com/jagdish3135/glim",
  "engines": { "node": ">=20.3" },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
